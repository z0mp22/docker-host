# Copy to /docker/homeassistant/secrets.yaml on the Pi (never commit the live file).
# Example placeholders — replace with real values on the host.

# github_coaching_report_token: "Bearer github_pat_xxxxxxxxxxxxxxxxxxxxxxxx"
# unifi_api_key: your_unifi_network_integration_api_key   # UDM > Settings > Control Plane > Integrations
# http_password: your_ha_http_password
# ha_long_lived_access_token: your_long_lived_access_token
# ha_username: your_ha_username
# ha_password: your_ha_password
# latitude: 47.2
# longitude: -122.4
# camera_admin_password: your_camera_admin_password
