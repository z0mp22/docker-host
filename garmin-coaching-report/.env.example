# Garmin Connect
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMINTOKENS=/root/.garminconnect
GARMIN_MAXCHART=500
GARMIN_MAXPOLY=0

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001
MAX_INPUT_TOKENS=180000
MAX_OUTPUT_TOKENS=8000
ENABLE_PROMPT_CACHE=true
HISTORY_WEEKS=8
# Reject a lookback window longer than this many days (guards token budget).
MAX_WINDOW_DAYS=31

# Gmail SMTP (use an App Password — https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# FatSecret nutrition (optional) — register a dev app at https://platform.fatsecret.com
# Leave blank to run the report without fueling data. After setting key/secret,
# authorize once with scripts/setup-fatsecret-auth.sh.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_TOKEN_PATH=/root/.fatsecret/token.json

# Output
REPORT_OUTPUT_DIR=/reports
UNIT_SYSTEM=metric
ATHLETE_TIMEZONE=America/Denver
ATHLETE_LOCATION=Fort Collins, CO
SAVE_DEBUG_INPUT=false
# Optional: anchor date for the run. Leave blank to use today. Format: YYYY-MM-DD
REPORT_DATE=
# Optional lookback-window overrides (normally set per-run by the workflow, not here):
#   SINCE   = <blank> (7 days ending yesterday) | last (resume after last report)
#             | Nd (N days back) | YYYY-MM-DD
#   THROUGH = <blank>/yesterday | today | YYYY-MM-DD
#   DRY_RUN = <blank>/false | true  (resolve + log the window, skip Claude + email)
SINCE=
THROUGH=
DRY_RUN=
