# Garmin Connect
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMINTOKENS=/root/.garminconnect
GARMIN_MAXCHART=500
GARMIN_MAXPOLY=0

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001
MAX_INPUT_TOKENS=180000
MAX_OUTPUT_TOKENS=8000
ENABLE_PROMPT_CACHE=true
HISTORY_WEEKS=8

# Gmail SMTP (use an App Password — https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# FatSecret nutrition (optional) — register a dev app at https://platform.fatsecret.com
# Leave blank to run the report without fueling data. After setting key/secret,
# authorize once with scripts/setup-fatsecret-auth.sh.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_TOKEN_PATH=/root/.fatsecret/token.json

# Output
REPORT_OUTPUT_DIR=/reports
UNIT_SYSTEM=metric
ATHLETE_TIMEZONE=America/Denver
ATHLETE_LOCATION=Fort Collins, CO
SAVE_DEBUG_INPUT=false
# Optional: generate a report for a specific week (week = the 7 days ending the
# day before this date). Leave blank to use today. Format: YYYY-MM-DD
REPORT_DATE=
