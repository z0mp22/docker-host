# Garmin Connect
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMINTOKENS=/root/.garminconnect

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_INPUT_TOKENS=900000

# Gmail SMTP (use an App Password — https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Output
REPORT_OUTPUT_DIR=/reports
UNIT_SYSTEM=metric
SAVE_DEBUG_INPUT=true
