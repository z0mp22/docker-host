# Copy to /docker/wger/.env on the Pi. deploy.sh's preserve_env_file() does
# this automatically on first deploy if the file is missing -- but the
# generated SECRET_KEY/JWT keys below MUST be regenerated by hand before
# this is used beyond a localhost smoke test (see README "wger" section).

# --- Security: MUST regenerate, do not ship the example values ---
# SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_regenerate_before_use
# JWT_PUBLIC_KEY / JWT_PRIVATE_KEY: docker compose exec web ./manage.py generate-jwt-keys
# (prints both values -- paste them here, then `docker compose up -d` to reload)
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# LAN-only for now (no TLS) -- set to this host's actual LAN IP/port.
SITE_URL=http://10.0.0.4:8010
# Django rejects any POST (e.g. the login form) whose Origin header isn't
# listed here, regardless of ALLOWED_HOSTS -- without this, logging in from
# the LAN IP fails with "Forbidden (CSRF verification failed)" even though
# the app is otherwise reachable. Must exactly match scheme+host+port.
CSRF_TRUSTED_ORIGINS=http://10.0.0.4:8010

TIME_ZONE=America/Denver
TZ=America/Denver

# SQLite, not Postgres -- single-user, lean deployment.
PS_DATABASE_URI=sqlite:////home/wger/data/database.sqlite
DJANGO_PERFORM_MIGRATIONS=True

# In-process cache, not Redis.
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=wger-local-cache
DJANGO_CACHE_TIMEOUT=1296000

# No Celery/Redis -- catalog sync runs once, in the foreground, on startup.
USE_CELERY=False
SYNC_EXERCISES_CELERY=False
SYNC_EXERCISE_IMAGES_CELERY=False
SYNC_EXERCISE_VIDEOS_CELERY=False
SYNC_INGREDIENTS_CELERY=False
CACHE_API_EXERCISES_CELERY=False
SYNC_EXERCISES_ON_STARTUP=True
DOWNLOAD_EXERCISE_IMAGES_ON_STARTUP=False
WGER_INSTANCE=https://wger.de

ALLOW_REGISTRATION=False
ALLOW_GUEST_USERS=False

DJANGO_DEBUG=False
WGER_USE_GUNICORN=True
GUNICORN_CMD_ARGS=--workers 2 --threads 2 --worker-class gthread --timeout 120
WGER_PORT=8000

ACCESS_TOKEN_LIFETIME=10
REFRESH_TOKEN_LIFETIME=2880
NUMBER_OF_PROXIES=1
LOG_LEVEL_PYTHON=INFO
FROM_EMAIL=wger <wger@localhost>
