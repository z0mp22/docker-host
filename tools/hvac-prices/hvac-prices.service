[Unit]
Description=Refresh HVAC cost prices (Fort Collins electric, Xcel gas) in Home Assistant
StartLimitIntervalSec=1d
StartLimitBurst=6

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/git/docker-host/tools/hvac-prices/update_hvac_prices.py
# A laptop waking up may not have network yet: retry hourly a few times.
Restart=on-failure
RestartSec=1h
